{
	"name": "next-debug",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "node --require ./range-logger.js node_modules/next/dist/bin/next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"db:migrate": "gel migration create && gel migrate && pnpm db:generate:all",
		"db:generate:all": "pnpm db:generate:edgeql && pnpm db:generate:interfaces && pnpm db:generate:queries",
		"db:generate:edgeql": "pnpx @edgedb/generate edgeql-js",
		"db:generate:interfaces": "pnpx @edgedb/generate interfaces",
		"db:generate:queries": "pnpx @edgedb/generate queries"
	},
	"dependencies": {
		"gel": "^2.1.1",
		"next": "16.0.2-canary.6",
		"react": "19.3.0-canary-67f7d47a-20251103",
		"react-dom": "19.3.0-canary-67f7d47a-20251103"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.0.1",
		"tailwindcss": "^4",
		"typescript": "^5"
	},
	"packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd",
	"pnpm": {
		"overrides": {
			"react": "19.3.0-canary-3a0ab8a7-20251029",
			"react-dom": "19.3.0-canary-3a0ab8a7-20251029"
		}
	}
}
