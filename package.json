{
	"name": "next-debug",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"postinstall": "node patch-visitAsyncNode.cjs",
		"dev": "node --require ./range-logger.js node_modules/next/dist/bin/next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"db:migrate": "gel migration create && gel migrate && pnpm db:generate:all",
		"db:generate:all": "pnpm db:generate:edgeql && pnpm db:generate:interfaces && pnpm db:generate:queries",
		"db:generate:edgeql": "pnpx @edgedb/generate edgeql-js",
		"db:generate:interfaces": "pnpx @edgedb/generate interfaces",
		"db:generate:queries": "pnpx @edgedb/generate queries"
	},
	"dependencies": {
		"gel": "^2.2.0",
		"next": "16.1.2",
		"react": "19.2.3",
		"react-dom": "19.2.3"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.1.18",
		"@types/node": "^25.0.8",
		"@types/react": "^19.2.8",
		"@types/react-dom": "^19.2.3",
		"eslint": "^9.39.2",
		"eslint-config-next": "16.1.2",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3"
	},
	"packageManager": "pnpm@10.26.1+sha512.664074abc367d2c9324fdc18037097ce0a8f126034160f709928e9e9f95d98714347044e5c3164d65bd5da6c59c6be362b107546292a8eecb7999196e5ce58fa"
}
